# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX      # ONE number, used for every test call

# The assessment line. Do not point this anywhere else.
TARGET_NUMBER=+18054398008

# OpenAI
OPENAI_API_KEY=sk-...
REALTIME_VOICE=sage
ANALYSIS_MODEL=gpt-4o

# Public hostname for Twilio -> your machine (ngrok, no scheme)
PUBLIC_HOST=xxxx-xx-xx-xx-xx.ngrok-free.app
PORT=8765
